# MediCare backend local configuration template
# Copy this file to backend/.env on your Windows machine and replace CHANGE_ME locally.
# Never commit backend/.env or place a real password in this template.
DJANGO_SECRET_KEY=your-secret-key-here
DEBUG=True
ALLOWED_HOSTS=127.0.0.1,localhost
FRONTEND_ALLOWED_ORIGINS=http://127.0.0.1:8010,http://localhost:8010

# Windows PostgreSQL 18.6 local instance
DB_NAME=medicare_db
DB_USER=medicare_app
DB_PASSWORD=CHANGE_ME
DB_HOST=localhost
DB_PORT=5432

# Leave blank to disable public administrator registration.
ADMIN_REGISTRATION_CODE=

# Reserved for later phases; leave empty until explicitly integrated.
AI_API_KEY=
OTHER_SERVICE_KEYS=

# Patient-facing symptom chatbot (Groq chat completions API). Get a free key at
# https://console.groq.com/keys. Leave blank to disable the chatbot endpoint.
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile
